# Required: your Anthropic API key (console.anthropic.com)
ANTHROPIC_API_KEY=

# Optional: model used by the agents (default: claude-sonnet-5-5)
FOUNDICA_MODEL=claude-sonnet-5-5

# Optional: max web searches per assessment (default 6). Each search is billed by Anthropic.
FOUNDICA_MAX_SEARCHES=6

# Optional: assessments allowed per IP per hour (default 5)
FOUNDICA_RATE_LIMIT_PER_HOUR=5

# Optional: if set, founders must enter this code to run an assessment (useful for a private beta)
FOUNDICA_ACCESS_CODE=

# Optional: webhook that receives founders who opt in (email, startup, scores) - e.g. Zapier/Make/Google Apps Script
FOUNDICA_LEAD_WEBHOOK_URL=

# Set to 1 to run without an API key using sample data (demo / testing)
MOCK_AI=0

# ---------- Accounts (required for launch) ----------
# Long random string; signs login cookies. Generate: openssl rand -base64 32
AUTH_SECRET=
# Email sign-in codes via Resend (resend.com). Verify thefoundica.com in Resend first.
RESEND_API_KEY=
FOUNDICA_EMAIL_FROM=Foundica <login@thefoundica.com>
# Storage: Upstash Redis from the Vercel Marketplace sets these two automatically
KV_REST_API_URL=
KV_REST_API_TOKEN=
FOUNDICA_SITE_URL=https://thefoundica.com
# Optional: free credits for every new account (e.g. 1 for invited pilot users)
FOUNDICA_WELCOME_CREDITS=0

# ---------- Payments: Dodo Payments (merchant of record, India + international) ----------
# Leave DODO_PAYMENTS_API_KEY empty = everything is free (private beta).
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PRODUCT_SINGLE=
DODO_PRODUCT_PACK=
# Prices shown on the site (the charged amount is the Dodo product price)
FOUNDICA_PRICE_SINGLE_INR=499
FOUNDICA_PRICE_PACK_INR=999
FOUNDICA_PACK_CREDITS=3
FOUNDICA_PRICE_SINGLE_USD=6
FOUNDICA_PRICE_PACK_USD=12

# ---------- Business details (shown on Contact/Terms/Privacy/Refund pages; Razorpay checks these) ----------
FOUNDICA_LEGAL_NAME=
FOUNDICA_ADDRESS=
FOUNDICA_PHONE=
NEXT_PUBLIC_FOUNDICA_CONTACT_EMAIL=
